#!name=🌐 Network Pro · 自动策略版
#!desc=自动识别 Surge 代理策略组和选中节点，监测本地网络、DNS、直连与代理出口;
#!category=Network
#!arguments=SHOW_SSID:true,REFRESH:300
#!arguments-desc=SHOW_SSID 是否显示Wi-Fi；REFRESH 刷新间隔秒数

[Panel]
Network Pro = title="Network Pro · 网络监控", content="正在检测网络...", icon=network, icon-color="#3B82F6", script-name=network-pro, update-interval={{{REFRESH}}}

[Script]
network-pro = type=generic, script-path=https://raw.githubusercontent.com/BrianLi-CN/surge-js/refs/heads/main/panel/network/network-pro.js, argument="{{{SHOW_SSID}}}", timeout=30
