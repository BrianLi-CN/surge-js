#!name=🌐 Network Pro · 自动策略版
#!desc=自动识别 Surge 代理策略组和选中节点，监测本地网络、DNS、直连与代理出口
#!system=mac
#!category=Network
#!arguments=SHOW_SSID:true,REFRESH:300
#!arguments-desc=SHOW_SSID 是否显示Wi-Fi名称(true/false)；REFRESH 刷新间隔(秒)。

[Panel]
Network Pro = title="🌐 Network Pro", content="正在检测网络信息...", style=info, script-name=network-pro-script, update-interval={{{REFRESH}}}

[Script]
network-pro-script = type=generic, script-path=https://raw.githubusercontent.com/BrianLi-CN/surge-js/refs/heads/main/panel/network/network-pro.js, argument="{{{SHOW_SSID}}}", timeout=30
