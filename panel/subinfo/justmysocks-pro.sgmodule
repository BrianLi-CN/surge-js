
#!name=💜 Just My Socks Pro
#!desc=JMS 套餐流量监控｜总量、已用、剩余、使用率、重置倒计时
#!category=SubInfo
#!arguments=API_URL,PLAN_NAME:LA 500,REFRESH:1800,REQUEST_POLICY:DIRECT
#!arguments-desc=API_URL 填写 Bandwidth Counter API 完整地址；PLAN_NAME 为套餐显示名称；REFRESH 为刷新秒数；REQUEST_POLICY 默认 DIRECT，也可填写已有代理策略名。

[Panel]
JMS Pro = title="Just My Socks · 订阅监控", content="请设置 Bandwidth Counter API 地址后刷新", icon=server.rack, icon-color="#8B5CF6", script-name=jms-pro, update-interval={{{REFRESH}}}

[Script]
jms-pro = type=generic, script-path=https://raw.githubusercontent.com/BrianLi-CN/surge-js/refs/heads/main/panel/subinfo/jms-pro.js, argument="{{{API_URL}}}|{{{PLAN_NAME}}}|{{{REQUEST_POLICY}}}", timeout=20
